{
  "name": "nova-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Nova UI — Vue 3.5 + TypeScript 企业级组件库（monorepo）",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "turbo run build",
    "build:components": "pnpm --filter @nova-ui/components build",
    "dev": "pnpm --filter playground dev",
    "dev:docs": "pnpm --filter docs dev",
    "build:docs": "pnpm --filter docs build",
    "preview:docs": "pnpm --filter docs preview",
    "lint": "eslint .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @nova-ui/components test:coverage",
    "e2e": "pnpm --filter e2e test",
    "size-check": "pnpm --filter playground size-check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vue-eslint-parser": "^9.4.3"
  }
}